# =============================================================================
# AIMS-System Environment Configuration
# Optional: every value below is also the built-in default. Copy this file to
# .env only to change something.
# =============================================================================

# === ROS2 ===
ROS_DISTRO=humble
ROS_DOMAIN_ID=5
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/app/aims_ws/src/fastdds_profile.xml

# === CSI Ingestion (UDP from PicoScenes) ===
# mock = replay a recorded frame (no hardware); picoscenes = UDP frames from
# PicoScenes on the host (see scripts/host/picoscenes_rx.sh)
CSI_SOURCE=mock
CSI_UDP_HOST=0.0.0.0
CSI_UDP_PORT=1025

# === Web Server ===
WEB_PORT=3001
NODE_ENV=development


# === Rosbridge (WebSocket bridge between ROS2 and Web) ===
ROSBRIDGE_PORT=9090

# === PicoScenes (host-only, read by scripts/host/*.sh, not by containers) ===
PICOSCENES_FORWARD_HOST=127.0.0.1
PICOSCENES_FORWARD_PORT=1025
PICOSCENES_NIC=wlp2s0
PICOSCENES_PHYPATH=2
PICOSCENES_FREQ=5180
PICOSCENES_BW=HT20
# TX machine only (picoscenes_tx.sh)
#PICOSCENES_TX_NIC=wlp1s0
PICOSCENES_TX_PHYPATH=1
PICOSCENES_TX_DELAY_US=10000

# === Vision (docker compose --profile vision) ===
# Inference device: cpu (default) or cuda:0. Left commented so that
# docker-compose.gpu.yml can default it to cuda:0.
#VISION_DEVICE=cpu
# Camera index (0 = /dev/video0) or a video file path inside the container,
# e.g. /app/captures/clip.mp4 (./captures is mounted read-only).
VISION_CAMERA=0
# Host device mapped to /dev/video0. Without a camera (e.g. Docker Desktop)
# set it to /dev/null and point VISION_CAMERA at a video file.
VISION_VIDEO_DEVICE=/dev/video0
