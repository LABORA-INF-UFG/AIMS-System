# =============================================================================
# AIMS-System Environment Configuration
# Copy this file to .env and adjust values as needed.
# =============================================================================

# === ROS2 ===
ROS_DISTRO=humble
ROS_DOMAIN_ID=5
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
FASTRTPS_DEFAULT_PROFILES_FILE=/app/aims_ws/src/fastdds_profile.xml

# === CSI Ingestion (UDP from PicoScenes) ===
CSI_UDP_HOST=0.0.0.0
CSI_UDP_PORT=1025

# === Web Server ===
WEB_PORT=3001
NODE_ENV=development


# === Rosbridge (WebSocket bridge between ROS2 and Web) ===
ROSBRIDGE_PORT=9090

# === PicoScenes (host-only, not used by containers) ===
PICOSCENES_FORWARD_HOST=127.0.0.1
PICOSCENES_FORWARD_PORT=1025
PICOSCENES_NIC=wlp2s0

# === AI Models (volume mounts) ===
KERAS_APNEA_MODEL=/app/models/apenaDetection_AIMS_model1.h5
