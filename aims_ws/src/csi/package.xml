<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>csi</name>
  <version>0.0.0</version>
  <description>AIMS CSI controller</description>
  <maintainer email="victorhullopes@gmail.com">Victor Hugo</maintainer>
  <license>Apache License 2.0</license>

  <!--
    Python dependencies are managed in requirements/core.in (locked in requirements/core.lock).
    The patched PicoScenes parser is built in docker/ros2/Dockerfile.
    Octave nodes are experimental and not included in the default build.
  -->
  
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>custom_interfaces</depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <depend>action_msgs</depend>
  <!-- <depend>octave</depend> removed: experimental nodes only -->
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
