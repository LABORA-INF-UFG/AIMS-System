# BuildKit uses this file instead of the root .dockerignore for
# docker/vision/Dockerfile. Allowlist: send only what the Dockerfile copies.
*
!aims_ws/src/vision/
!aims_ws/src/fastdds_profile.xml
!requirements/vision-*.lock
!docker/ros2/entrypoint.sh

# Never ship weights, exported engines or Python caches
**/*.pt
**/*.engine
**/*.onnx
**/*.tflite
**/__pycache__
